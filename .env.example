# ============================================================
# VIDYARANYA — Environment Variables Template (Phase 2)
# Copy this file to .env and fill in real values.
# ============================================================

# --- Database ---
# Option A: Local PostgreSQL (Docker Compose)
DATABASE_URL=postgresql://eduuser:your_db_password@db:5432/eduai_db

# Option B: Supabase PostgreSQL (Phase 2 target)
# Get the connection string from:
#   Supabase Dashboard → Project → Settings → Database → Connection string (URI mode)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- JWT ---
SECRET_KEY=replace_with_minimum_32_character_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Frontend ---
FRONTEND_URL=http://localhost
FRONTEND_ALLOWED_HOSTS=["localhost","127.0.0.1"]
ENABLE_DEV_LOGIN=true

# --- AI / Groq ---
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google OAuth ---
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# --- Cloudflare R2 Object Storage (Phase 1) ---
# Leave blank to use local filesystem fallback
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=vidyaranya-bucket
# STORAGE_BACKEND options: "auto" (use R2 if credentials present), "r2", "local"
STORAGE_BACKEND=auto

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:80"]
BACKEND_CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2}|192\.168(?:\.\d{1,3}){2})(?::\d+)?$
